# ==============================================================================
# BB Cakes - Git Ignore Configuration
# ==============================================================================

# Dependencies (HUGE - Never commit dependencies)
node_modules/
**/node_modules/
.pnp
.pnp.js

# Next.js Build Output & Cache
.next/
**/.next/
out/
build/
dist/

# TypeScript Build Info Cache
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Environment & Sensitive Credentials (CRITICAL)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor & IDE Configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Testing & Coverage
coverage/
.nyc_output/

# Vercel Deployment
.vercel/
